#!/usr/bin/env bash
# /opt/ci/bin/github-pull <project>
#
# Deploy the newest green commit of a GitHub project. Run every five minutes by
# github-pull@<project>.timer, as ci.
#
# PULL, NOT PUSH. This is the GitHub twin of /opt/ci/bin/gitlab-pull, and it
# exists for the same reason: a self-hosted runner lets GitHub -- and, in a
# public repo, anyone who opens a pull request -- start a process on this box.
# A timer that reads cannot be made to deploy anything. No runner token lives
# here and no inbound connection exists.
#
# No retry loop. A commit whose deploy failed (and was rolled back) is recorded
# in state/<project>.tried and not attempted again; the next green commit is.
#
# TWO SHAPES OF PROJECT:
#   compose - the box checks the commit out and builds it, so it only needs the
#             sha. The gate is the GitHub API: the newest run on BRANCH with
#             conclusion success, event push or workflow_dispatch, built from
#             this repository and not from a fork. /opt/ci/bin/deploy then
#             re-checks that the sha is on origin/BRANCH, as it always does.
#             Listing runs of a public repo needs no credential; while the repo
#             is private the call fails and nothing is deployed.
#   static  - the box has no node and no business getting one, so it does not
#             build. A green run pushes the finished app to SITE_BRANCH, and the
#             box pulls that branch with the project's read-only deploy key. A
#             commit on that branch exists only because a green run on BRANCH
#             made it; its subject line is the commit it was built from. Fork
#             pull requests get a read-only token from GitHub whatever their
#             workflow file asks for, so they cannot write that branch.
#             SITE_SUBDIR is published, so the checkout's .git stays out of it.
set -euo pipefail

PROJECT="${1:-}"
case "$PROJECT" in
	'' | *[!a-z0-9-]*) echo "usage: github-pull <project>" >&2; exit 2 ;;
esac
CONF="/opt/ci/projects/$PROJECT.conf"
[ -f "$CONF" ] || { echo "github-pull: no such project '$PROJECT'" >&2; exit 2; }

KIND=compose
BRANCH=main
WORKDIR=""
GITHUB_REPO=""
WORKFLOW=""
SITE_REMOTE=""
SITE_BRANCH=site
SITE_CHECKOUT=""
SITE_SUBDIR=site
# shellcheck disable=SC1090
. "$CONF"

STATE=/opt/ci/state

note_and_deploy() {
	# Burning the .tried slot before the deploy is deliberate: a commit that
	# fails must not be retried every five minutes.
	local sha="$1"; shift
	echo "$sha" > "$STATE/$PROJECT.tried"
	exec env DEPLOY_SHA="$sha" /opt/ci/bin/deploy "$PROJECT" "$@"
}

is_new() {
	local sha="$1"
	[ "$sha" = "$(cat "$STATE/$PROJECT.sha" 2>/dev/null || true)" ] && return 1
	[ "$sha" = "$(cat "$STATE/$PROJECT.tried" 2>/dev/null || true)" ] && return 1
	return 0
}

# ---------------------------------------------------------------- static
if [ "$KIND" = "static" ]; then
	[ -n "$SITE_CHECKOUT" ] || { echo "github-pull: $CONF is KIND=static but sets no SITE_CHECKOUT" >&2; exit 2; }
	[ -d "$SITE_CHECKOUT/.git" ] || { echo "github-pull: $SITE_CHECKOUT is not a checkout of $SITE_BRANCH" >&2; exit 2; }

	# Before the first green run the branch does not exist. Asking first keeps
	# git's "couldn't find remote ref" out of the journal every five minutes,
	# while a fetch that fails for a real reason stays loud.
	git -C "$SITE_CHECKOUT" ls-remote --exit-code --heads origin "$SITE_BRANCH" >/dev/null 2>&1 || exit 0

	# GitHub unreachable is not an error worth a failed unit: try again next tick.
	git -C "$SITE_CHECKOUT" fetch -q --depth 1 origin "$SITE_BRANCH" || exit 0

	subject=$(git -C "$SITE_CHECKOUT" log -1 --format=%s FETCH_HEAD)
	sha="${subject%% *}"
	[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || {
		echo "github-pull: $SITE_BRANCH head says '$subject', which is not a commit" >&2; exit 1; }

	# No ancestry check here, unlike the compose shape below: the branch is
	# force-pushed by every green run, so its head is the newest build there
	# is, and it shares no history with BRANCH to compare against anyway.
	is_new "$sha" || exit 0

	git -C "$SITE_CHECKOUT" reset -q --hard FETCH_HEAD
	git -C "$SITE_CHECKOUT" clean -qfdx
	SRC="$SITE_CHECKOUT/$SITE_SUBDIR"
	[ -f "$SRC/index.html" ] || { echo "github-pull: $SRC holds no index.html" >&2; exit 1; }

	note_and_deploy "$sha" --from "$SRC"
fi

# ---------------------------------------------------------------- compose
[ -n "$GITHUB_REPO" ] || { echo "github-pull: $CONF has no GITHUB_REPO" >&2; exit 2; }
case "$GITHUB_REPO" in
	*/*) : ;;
	*) echo "github-pull: GITHUB_REPO must be owner/name" >&2; exit 2 ;;
esac

runs=$(curl -sf --max-time 20 \
	-H "Accept: application/vnd.github+json" \
	-H "X-GitHub-Api-Version: 2022-11-28" \
	"https://api.github.com/repos/$GITHUB_REPO/actions/runs?branch=$BRANCH&status=success&per_page=20") || exit 0

sha=$(printf '%s' "$runs" | REPO="$GITHUB_REPO" BRANCH="$BRANCH" WORKFLOW="$WORKFLOW" python3 -c '
import json, os, sys
repo, branch, workflow = os.environ["REPO"], os.environ["BRANCH"], os.environ["WORKFLOW"]
runs = json.load(sys.stdin).get("workflow_runs", [])

def ok(r):
    if r.get("conclusion") != "success":
        return False
    # a pull_request run builds the fork s code inside this repo, and its
    # head_branch can be called "main" too. Those runs are never deployed.
    if r.get("event") not in ("push", "workflow_dispatch"):
        return False
    if r.get("head_branch") != branch:
        return False
    if (r.get("head_repository") or {}).get("full_name") != repo:
        return False
    if workflow and r.get("name") != workflow:
        return False
    return True

good = [r for r in runs if ok(r)]
if good:
    print(max(good, key=lambda r: r["run_number"])["head_sha"])
')
[ -n "$sha" ] || exit 0
[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || { echo "github-pull: unexpected sha '$sha'" >&2; exit 1; }

is_new "$sha" || exit 0

# NEVER GO BACKWARDS. "Newest green run" is not the same as "newest commit":
# when the runs after it never started -- a broken workflow file, an exhausted
# Actions budget -- the newest green run can be older than what is live, and
# deploying it would roll the service back to an earlier commit. So the
# candidate has to have the live commit in its history.
live=$(cat "$STATE/$PROJECT.sha" 2>/dev/null || true)
if [ -n "$live" ] && [ "$live" != unknown ] && [ -d "$WORKDIR" ]; then
	git -C "$WORKDIR" fetch -q origin "$BRANCH" || exit 0
	git -C "$WORKDIR" merge-base --is-ancestor "$live" "$sha" 2>/dev/null || {
		echo "github-pull: newest green $PROJECT run ($sha) does not follow the live commit ($live); not deploying" >&2
		exit 0
	}
fi

# compose takes the sha as its argument: the box checks that commit out itself
note_and_deploy "$sha" "$sha"
