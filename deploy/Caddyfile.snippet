# Installed in /etc/caddy/Caddyfile on the Hetzner box.
mci.quocnamtran.com {
	import common

	# Open Food Facts search sends no CORS headers, so the app asks us instead.
	handle_path /off/* {
		reverse_proxy https://search.openfoodfacts.org {
			header_up Host search.openfoodfacts.org
			header_up User-Agent "Zyklus/1.0 (mci.quocnamtran.com)"
			header_up -Cookie
		}
	}

	# accounts and sync (zyklus-api container)
	handle /api/* {
		reverse_proxy 127.0.0.1:8006
	}

	handle {
		root * /opt/zyklus/site
		# the service worker and the shell must never be stale
		@fresh path / /index.html /sw.js /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
